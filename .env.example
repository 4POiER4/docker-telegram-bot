# Имена контейнеров из колонки NAMES команды docker ps -a.
WATCH_CONTAINERS=nginx,postgres

# Замени 0 на число, которое выведет команда chat-id.
TELEGRAM_CHAT_ID=0
# Дополнительные личные чаты с доступом к /status, через запятую.
TELEGRAM_STATUS_CHAT_IDS=
SERVER_NAME=Мой сервер

# Если Docker использует другой Unix-сокет, укажи путь здесь.
# DOCKER_SOCKET=/var/run/docker.sock
